#!/usr/bin/env python3
"""nputop - monitor tipo htop para a NPU Intel (AI Boost / intel_vpu).

  nputop              TUI, refresh 1s          q sai · +/- ajusta o refresh
  nputop -d 0.5       refresh de 0,5s
  nputop --once       uma amostra em texto puro (scripts, cron)
  nputop --csv        streaming CSV: ts,util,freq_mhz,mem_bytes,procs

Utilizacao vem do delta de npu_busy_time_us. Memoria por processo vem do
DRM fdinfo (drm-total-memory). O driver nao expoe drm-engine-*, entao NAO
existe tempo de NPU por processo -- a coluna MEM e o que da pra atribuir.

Sem root voce so enxerga os seus proprios processos.
"""
import argparse, curses, glob, os, pwd, sys, time
from collections import deque

DEV = "/sys/class/accel/accel0/device"


def rd(name, default=None):
    try:
        with open(os.path.join(DEV, name)) as f:
            return f.read().strip()
    except OSError:
        return default


def rdint(name, default=0):
    v = rd(name)
    try:
        return int(v)
    except (TypeError, ValueError):
        return default


def procs():
    """Processos com /dev/accel aberto -> (pid, user, mem_kib, cmd), maior primeiro."""
    out = []
    for fdinfo in glob.glob("/proc/[0-9]*/fdinfo/*"):
        pid = fdinfo.split("/")[2]
        fd = fdinfo.rsplit("/", 1)[1]
        try:
            if "accel" not in os.readlink(f"/proc/{pid}/fd/{fd}"):
                continue
            with open(fdinfo) as f:
                info = dict(
                    (k.strip(), v.strip())
                    for k, _, v in (l.partition(":") for l in f)
                )
            if info.get("drm-driver") != "intel_vpu":
                continue
            mem = int(info.get("drm-total-memory", "0 KiB").split()[0])
            st = os.stat(f"/proc/{pid}")
            user = pwd.getpwuid(st.st_uid).pw_name
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmd = f.read().replace(b"\0", b" ").decode("utf-8", "replace").strip()
            if not cmd:
                with open(f"/proc/{pid}/comm") as f:
                    cmd = f.read().strip()
            out.append((int(pid), user, mem, cmd))
        except (OSError, KeyError, ValueError, IndexError):
            continue
    out.sort(key=lambda p: -p[2])
    return out


def human(b):
    for u in ("B", "KiB", "MiB", "GiB"):
        if abs(b) < 1024 or u == "GiB":
            return f"{b:.0f} {u}" if u == "B" else f"{b:.1f} {u}"
        b /= 1024


class Sampler:
    """Converte o contador acumulado npu_busy_time_us em utilizacao %."""

    def __init__(self):
        self.busy = rdint("npu_busy_time_us")
        self.t = time.monotonic()

    def sample(self):
        busy, t = rdint("npu_busy_time_us"), time.monotonic()
        dbusy, dt = busy - self.busy, t - self.t
        self.busy, self.t = busy, t
        if dt <= 0:
            return 0.0
        if dbusy < 0:          # contador zerou (reset do device)
            return 0.0
        return max(0.0, min(100.0, dbusy / (dt * 1e6) * 100.0))


def snapshot(util):
    freq, mx = rdint("npu_current_frequency_mhz"), rdint("npu_max_frequency_mhz", 1)
    return {
        "util": util,
        "freq": freq,
        "maxfreq": mx,
        "mem": rdint("npu_memory_utilization"),
        "busy": rdint("npu_busy_time_us"),
        "sched": rd("sched_mode", "?"),
        "procs": procs(),
    }


SPARK = " ▁▂▃▄▅▆▇█"


def tui(stdscr, args):
    curses.curs_set(0)
    stdscr.nodelay(True)
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        for i, c in enumerate((curses.COLOR_GREEN, curses.COLOR_YELLOW,
                               curses.COLOR_RED, curses.COLOR_CYAN), 1):
            curses.init_pair(i, c, -1)
    GREEN, YELLOW, RED, CYAN = (curses.color_pair(i) for i in range(1, 5))

    s, hist, delay = Sampler(), deque(maxlen=180), args.delay
    name = rd("../accel0/device/uevent") or ""
    while True:
        time.sleep(delay)
        d = snapshot(s.sample())
        hist.append(d["util"])
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        col = GREEN if d["util"] < 50 else YELLOW if d["util"] < 85 else RED

        def put(y, x, text, attr=0):
            if 0 <= y < h and x < w:
                stdscr.addnstr(y, x, text, max(0, w - x - 1), attr)

        put(0, 0, " nputop ", curses.A_REVERSE | curses.A_BOLD)
        put(0, 9, "Intel AI Boost (intel_vpu)  0000:00:0b.0", curses.A_BOLD)
        put(0, max(0, w - 22), f"refresh {delay:.1f}s  q=sai", curses.A_DIM)

        barw = max(10, w - 26)
        fill = int(barw * d["util"] / 100)
        put(2, 0, "NPU ", curses.A_BOLD)
        put(2, 4, "[")
        put(2, 5, "|" * fill, col | curses.A_BOLD)
        put(2, 5 + fill, " " * (barw - fill))
        put(2, 5 + barw, "]")
        put(2, 7 + barw, f"{d['util']:5.1f}%", col | curses.A_BOLD)

        pct = d["freq"] / d["maxfreq"] * 100 if d["maxfreq"] else 0
        put(3, 0, "FRQ ", curses.A_BOLD)
        put(3, 4, f"{d['freq']:>4} MHz / {d['maxfreq']} MHz  ({pct:.0f}%)"
                  f"   sched={d['sched']}", CYAN if d["freq"] else curses.A_DIM)
        put(4, 0, "MEM ", curses.A_BOLD)
        put(4, 4, f"{human(d['mem'])} alocados no device"
                  f"   ·  busy acumulado {d['busy']/1e6:.1f}s desde o boot")

        put(6, 0, "".join(SPARK[min(8, int(u / 12.5))] for u in hist)[-max(1, w - 2):], col)

        put(8, 0, f"{'PID':>7}  {'USUARIO':<12} {'MEM NPU':>10}  COMANDO",
            curses.A_REVERSE)
        rows = d["procs"]
        for i, (pid, user, mem, cmd) in enumerate(rows[: max(0, h - 10)]):
            put(9 + i, 0, f"{pid:>7}  {user:<12} {mem/1024:>7.1f} MiB  {cmd}")
        if not rows:
            put(9, 0, "  nenhum processo com a NPU aberta"
                      + ("" if os.geteuid() == 0 else "  (sem root: so os seus)"),
                curses.A_DIM)

        stdscr.refresh()
        try:
            k = stdscr.getkey()
        except curses.error:
            continue
        if k in ("q", "Q"):
            return
        if k in ("+", "="):
            delay = min(10.0, delay + 0.5)
        elif k == "-":
            delay = max(0.1, delay - 0.5)


def main():
    ap = argparse.ArgumentParser(description="monitor tipo htop para a NPU Intel")
    ap.add_argument("-d", "--delay", type=float, default=1.0, help="refresh em segundos")
    ap.add_argument("--once", action="store_true", help="uma amostra em texto puro")
    ap.add_argument("--csv", action="store_true", help="streaming CSV")
    args = ap.parse_args()

    if not os.path.exists(DEV):
        sys.exit("nputop: /sys/class/accel/accel0 nao existe — o intel_vpu esta carregado?")

    if args.once or args.csv:
        s = Sampler()
        time.sleep(args.delay)
        if args.once:
            d = snapshot(s.sample())
            print(f"util {d['util']:.1f}%   freq {d['freq']}/{d['maxfreq']} MHz   "
                  f"mem {human(d['mem'])}   sched {d['sched']}   "
                  f"busy {d['busy']/1e6:.1f}s")
            for pid, user, mem, cmd in d["procs"]:
                print(f"  {pid:>7}  {user:<12} {mem/1024:>7.1f} MiB  {cmd[:70]}")
            return
        print("timestamp,util_pct,freq_mhz,mem_bytes,procs", flush=True)
        while True:
            d = snapshot(s.sample())
            print(f"{time.time():.0f},{d['util']:.1f},{d['freq']},{d['mem']},"
                  f"{len(d['procs'])}", flush=True)
            time.sleep(args.delay)

    try:
        curses.wrapper(tui, args)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
